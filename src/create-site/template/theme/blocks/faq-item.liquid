<details class="faq__item" data-block-id="{{ block.id }}">
  <summary>{{ block.settings.question }}</summary>
  <div class="prose">{{ block.settings.answer | raw }}</div>
</details>
{% schema %}
{
  "title": "Question",
  "description": "One question and its answer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "answer"],
  "properties": {
    "question": { "type": "string", "minLength": 1, "default": "A question people often ask?" },
    "answer": { "type": "string", "format": "richtext", "minLength": 1, "default": "<p>Its answer, in a few sentences.</p>" }
  }
}
{% endschema %}
