{%- assign site_name = settings.site_name | default: 'Your site name' -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if page.title == site_name %}{{ site_name }}{% else %}{{ page.title }} | {{ site_name }}{% endif %}</title>
    {% if settings.description != blank %}<meta name="description" content="{{ settings.description }}">{% endif %}
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/style.css">
    {%- comment -%}
      The accent colour and font are site settings: editors choose them in
      the admin, and the CSS reads them as custom properties.
    {%- endcomment -%}
    <style>:root { --accent: {{ settings.accent_colour | default: '#2b59c3' }};{% if settings.body_font == 'Serif' %} --font-body: var(--font-serif);{% endif %} }</style>
    <script src="/assets/site.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">
          {%- comment -%}
            A plain <img>, not the responsive-media snippet: the logo lives in
            site settings, not in a section, so there is nothing for a
            drag-and-drop in the preview to write to. It changes in Settings.
          {%- endcomment -%}
          {%- if settings.logo.url != blank -%}
            <img class="site-header__logo" src="{{ settings.logo.url }}" alt="{{ site_name }}">
          {%- else -%}
            {{ site_name }}
          {%- endif -%}
        </a>

        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul>
            {% for item in menus.main.items %}
              <li><a href="{{ item.url }}">{{ item.label }}</a></li>
            {% endfor %}
          </ul>
          {% if settings.header_button_label != blank and settings.header_button_url != blank %}
            <a class="btn btn--primary btn--small" href="{{ settings.header_button_url }}">{{ settings.header_button_label }}</a>
          {% endif %}
        </nav>

        <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" data-nav-toggle>
          <span class="nav-toggle__bars" aria-hidden="true"></span>
          <span class="visually-hidden">Menu</span>
        </button>
      </div>
    </header>

    <main id="main">
      {{ content_for_layout | raw }}
    </main>

    <footer class="site-footer">
      <div class="container site-footer__grid">
        <div class="site-footer__about">
          <p class="site-footer__name">{{ site_name }}</p>
          {% if settings.footer_text != blank %}<p>{{ settings.footer_text | escape | newline_to_br | raw }}</p>{% endif %}
          {% render 'social-links' %}
        </div>

        {% if menus.footer.items.size > 0 %}
          <nav class="site-footer__nav" aria-label="{{ menus.footer.name | default: 'Footer' }}">
            <ul>
              {% for item in menus.footer.items %}
                <li><a href="{{ item.url }}">{{ item.label }}</a></li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}

        <div class="site-footer__contact">
          {% if settings.email != blank %}<p><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></p>{% endif %}
          {% if settings.phone != blank %}<p><a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone }}</a></p>{% endif %}
          {% if settings.address != blank %}<p>{{ settings.address | escape | newline_to_br | raw }}</p>{% endif %}
        </div>
      </div>
      <div class="container site-footer__base">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ site_name }}</p>
      </div>
    </footer>
  </body>
</html>
