<section class="section hero{% if section.settings.align == 'Centre' %} hero--centre{% endif %}{% if section.settings.image.url %} hero--with-media{% endif %}" data-section-id="{{ section.id }}">
  <div class="container hero__inner">
    <div class="hero__content">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}<p class="lead">{{ section.settings.text | escape | newline_to_br | raw }}</p>{% endif %}
      {% if blocksHtml.size > 0 %}<div class="actions">{% for html in blocksHtml %}{{ html | raw }}{% endfor %}</div>{% endif %}
    </div>
    {% if section.settings.image.url %}
      {% render 'responsive-media',
           media: section.settings.image,
           kind: 'image',
           field: 'image',
           alt: section.settings.image_alt,
           ratio: '4 / 3',
           loading: 'eager',
           priority: true,
           class: 'hero__media' %}
    {% endif %}
  </div>
</section>
{% schema %}
{
  "title": "Hero",
  "description": "The big opening heading at the top of a page, with optional buttons and picture.",
  "type": "object",
  "additionalProperties": false,
  "required": ["heading"],
  "properties": {
    "eyebrow": { "type": "string", "title": "Small text above the heading" },
    "heading": { "type": "string", "minLength": 1, "default": "Say what you do in one clear sentence." },
    "text": { "type": "string", "format": "textarea" },
    "image": { "type": "object", "format": "image", "title": "Picture" },
    "image_alt": { "type": "string", "title": "Describe the picture", "description": "For people who can't see it, and for search engines." },
    "align": { "type": "string", "enum": ["Left", "Centre"], "title": "Alignment", "default": "Left" }
  },
  "allowedBlocks": ["button"]
}
{% endschema %}
