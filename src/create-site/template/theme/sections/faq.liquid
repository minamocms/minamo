<section class="section{% if section.settings.tinted %} section--tinted{% endif %}" data-section-id="{{ section.id }}">
  <div class="container container--narrow">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    <div class="faq">
      {% for html in blocksHtml %}{{ html | raw }}{% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "title": "Questions and answers",
  "description": "A list of questions that open to show their answers.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "heading": { "type": "string", "default": "Questions people ask" },
    "tinted": { "type": "boolean", "format": "toggle", "title": "Tinted background" }
  },
  "allowedBlocks": ["faq-item"]
}
{% endschema %}
